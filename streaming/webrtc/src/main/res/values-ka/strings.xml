    <string name="webrtc_method_title">WebRTC: გაზიარება მთელ მსოფლიოში</string>
    <string name="webrtc_method_summary">გაუზიარეთ ეკრანი მაყურებლებს ნებისმიერ ადგილას ბმულის საშუალებით.</string>
    <string name="webrtc_method_conditions">ყურება ბრაუზერში · არჩევითი აუდიო · საჭიროა ინტერნეტი</string>
    <string name="webrtc_method_intro">WebRTC პირდაპირ ვიდეოს, და სურვილისამებრ აუდიოსაც, ინტერნეტით მაყურებლების ბრაუზერებში აგზავნის. მაყურებლები უერთდებიან თქვენი გაზიარების ბმულით ან თქვენი სტრიმის ID-ით და პაროლით.</string>
    <string-array name="webrtc_method_benefits">
        <item>მოიწვიეთ სხვა ქსელებში მყოფი მაყურებლები screenstream.io-ზე თქვენი სტრიმის ID-ით და პაროლით.</item>
        <item>ვიდეო და აუდიო დაშიფრულია და თითოეულ სტრიმს პაროლი აქვს.</item>
        <item>დაამატეთ მიკროფონის აუდიო, მოწყობილობის აუდიო ან ორივე.</item>
    </string-array>
    <string-array name="webrtc_method_things_to_know">
        <item>ამ მოწყობილობას და ყველა მაყურებელს ინტერნეტი სჭირდება.</item>
        <item>თითოეული მაყურებელი ცალკე სტრიმს იღებს, ამიტომ მეტი მაყურებელი მეტ ატვირთვის მონაცემს მოიხმარს.</item>
    </string-array>

