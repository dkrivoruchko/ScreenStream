<resources>
    <!-- Mode -->
    <string name="mjpeg_method_title">MJPEG: ब्राउज़र में सीधे देखें</string>
    <string name="mjpeg_method_summary">दर्शक ब्राउज़र में देखते हैं और सीधे इस डिवाइस से जुड़ते हैं। इंटरनेट की ज़रूरत नहीं।</string>
    <string name="mjpeg_method_conditions">ऑडियो नहीं · पहुंच योग्य, भरोसेमंद नेटवर्क · बिना एन्क्रिप्शन वाला HTTP</string>
    <string name="mjpeg_method_intro">MJPEG आपकी स्क्रीन को तेज़ी से बदलती तस्वीरों की सीरीज़ के रूप में दिखाता है। दर्शक ब्राउज़र में लिंक खोलते हैं और सीधे इस डिवाइस से जुड़ते हैं।</string>
    <string-array name="mjpeg_method_benefits">
        <item>दर्शकों को बस एक लिंक खोलना होता है। किसी ऐप या खाते की ज़रूरत नहीं।</item>
        <item>दर्शक इस डिवाइस तक पहुंच सकें, तो इंटरनेट के बिना काम करता है।</item>
        <item>तस्वीर की काट-छांट करें, साइज़ बदलें, घुमाएं या मिरर करें।</item>
        <item>वैकल्पिक PIN से स्ट्रीम को सुरक्षित रखें। ऐक्सेस लिंक से आमंत्रित दर्शक PIN डाले बिना देख सकते हैं।</item>
        <item>MJPEG या JPEG लिंक स्वीकार करने वाले दूसरे ऐप भी स्ट्रीम दिखा सकते हैं।</item>
    </string-array>
    <string-array name="mjpeg_method_things_to_know">
        <item>सिर्फ़ तस्वीरें। ऑडियो नहीं।</item>
        <item>दर्शकों को इस डिवाइस से सीधे जुड़ना होगा, जैसे एक ही Wi-Fi पर या VPN के ज़रिए। गेस्ट और सार्वजनिक नेटवर्क अक्सर इसे ब्लॉक करते हैं।</item>
        <item>कनेक्शन एन्क्रिप्ट नहीं होता। भरोसेमंद नेटवर्क इस्तेमाल करें।</item>
        <item>हर दर्शक को अलग इमेज मिलती हैं, इसलिए ज़्यादा दर्शकों से ज़्यादा डेटा खर्च होता है।</item>
    </string-array>

