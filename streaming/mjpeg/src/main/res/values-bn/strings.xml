    <!-- Mode -->
    <string name="mjpeg_method_title">MJPEG: সরাসরি ব্রাউজারে দেখা</string>
    <string name="mjpeg_method_summary">দর্শকরা সরাসরি এই ডিভাইসে সংযুক্ত হয়ে ব্রাউজারে দেখেন। ইন্টারনেট লাগে না।</string>
    <string name="mjpeg_method_conditions">অডিও নেই · পৌঁছানো যায় এমন বিশ্বস্ত নেটওয়ার্ক · এনক্রিপশনবিহীন HTTP</string>
    <string name="mjpeg_method_intro">MJPEG আপনার স্ক্রিনকে দ্রুত পরপর ছবির সারি হিসেবে দেখায়। দর্শকরা ব্রাউজারে একটি লিঙ্ক খোলেন এবং সরাসরি এই ডিভাইসে সংযুক্ত হন।</string>
    <string-array name="mjpeg_method_benefits">
        <item>দর্শকদের শুধু একটি লিঙ্ক খুলতে হয়। কোনও অ্যাপ বা অ্যাকাউন্ট লাগে না।</item>
        <item>দর্শকরা এই ডিভাইসে পৌঁছাতে পারলে ইন্টারনেট ছাড়াই কাজ করে।</item>
        <item>ছবি ক্রপ করুন, আকার বদলান, ঘোরান বা মিরর করুন।</item>
        <item>ঐচ্ছিক PIN দিয়ে দেখা সুরক্ষিত রাখুন। অ্যাক্সেস লিঙ্ক দিয়ে আমন্ত্রিত দর্শকরা PIN না লিখেই ঢুকতে পারেন।</item>
        <item>MJPEG বা JPEG লিঙ্ক গ্রহণ করে এমন অন্য অ্যাপও স্ট্রিম দেখাতে পারে।</item>
    </string-array>
    <string-array name="mjpeg_method_things_to_know">
        <item>শুধু ছবি। অডিও নেই।</item>
        <item>দর্শকদের সরাসরি এই ডিভাইসে সংযুক্ত হতে হবে, যেমন একই Wi-Fi-তে বা VPN-এর মাধ্যমে। গেস্ট ও পাবলিক নেটওয়ার্ক প্রায়ই এটি ব্লক করে।</item>
        <item>সংযোগটি এনক্রিপ্ট করা নয়। আপনার বিশ্বস্ত নেটওয়ার্ক ব্যবহার করুন।</item>
        <item>প্রতিটি দর্শক আলাদা ছবি পান, তাই দর্শক বেশি হলে ডেটাও বেশি লাগে।</item>
    </string-array>

