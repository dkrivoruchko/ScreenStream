    <string name="rtmp_method_title">RTMP: Pamuter lan server media</string>
    <string name="rtmp_method_summary">Nonton ing pamuter video, utawa kirim streaming menyang server media.</string>
    <string name="rtmp_method_conditions">Piranti lunak RTMP sing kompatibel · Audio opsional</string>
    <string name="rtmp_method_intro">RTMP iku standar streaming umum sing digunakake pamuter video lan server media. Sacara gawan, piranti iki sing dadi host streaming. Sampeyan uga bisa ngirim menyang server media.</string>
    <string-array name="rtmp_method_benefits">
        <item>Nonton ing pamuter kayata VLC kanthi mbukak alamat RTMP sing ditampilake ing aplikasi.</item>
        <item>Kirim streaming menyang server media, kalebu server sing njaluk jeneng pangguna lan sandhi.</item>
        <item>Tambah audio mikropon, audio piranti, utawa loro-lorone.</item>
        <item>Pilih format video lan audio, ukuran lan kualitas sing cocog karo pamuter utawa server sampeyan.</item>
    </string-array>
    <string-array name="rtmp_method_things_to_know">
        <item>Pamuter kudu bisa nyambung menyang piranti iki, contone ing Wi-Fi sing padha. Dadi host bisa tanpa internet.</item>
        <item>Nalika ngirim menyang server, piranti iki kudu bisa nggayuh server kasebut. Kanggo sambungan sing dienkripsi, gunakake alamat rtmps://. Formate yaiku rtmp://host/app/streamKey.</item>
        <item>Pamuter utawa server sampeyan kudu ndhukung format sing sampeyan pilih. H.264 karo AAC bisa digunakake ing endi wae; H.265 mbutuhake dhukungan Enhanced RTMP.</item>
    </string-array>

