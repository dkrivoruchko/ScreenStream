    <!-- Mode -->
    <string name="mjpeg_mode_name">የአካባቢ ሁነታ · MJPEG</string>
    <string name="mjpeg_mode_description">ስለ MJPEG</string>
    <string name="mjpeg_mode_details">የመሣሪያውን ማያ ገጽ እንደ JPEG ምስሎች በቀጥታ ወደ ድር አሳሽ ያሰራጩ። ድምፅ አይሰራጭም።\n\n• ያለ በይነመረብ በአካባቢ አውታረ መረብ ላይ ይሰራል። ተመልካቾች የስርጭቱን አድራሻ መድረስ መቻል አለባቸው።\n• የPIN ጥበቃ አማራጭ ነው። ሲበራ፣ ተመልካቾች PIN ማስገባት ወይም የመዳረሻ አገናኝ መጠቀም ይችላሉ።\n• ስርጭቱ ያልተመሰጠረ HTTP ይጠቀማል። የሚታመን አውታረ መረብ ይጠቀሙ።\n• የአውታረ መረብ ማጣሪያው Wi-Fi፣ Ethernet፣ የተንቀሳቃሽ ስልክ ውሂብ፣ VPN፣ IPv4 እና IPv6 አማራጮች አሉት።\n• የምስል መጠን፣ የJPEG ጥራት እና የፍሬም ፍጥነት ያስተካክሉ።\n• ምስሎች ለእያንዳንዱ ተመልካች በተለየ ይላካሉ፣ ስለዚህ የውሂብ አጠቃቀም ይጨምራል።</string>

