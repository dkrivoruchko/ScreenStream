<resources>
    <!-- Mode -->
    <string name="mjpeg_method_title">MJPEG: براؤزر میں براہ راست دیکھنا</string>
    <string name="mjpeg_method_summary">ناظرین براؤزر میں دیکھتے ہیں اور براہ راست اس آلے سے منسلک ہوتے ہیں۔ انٹرنیٹ کی ضرورت نہیں۔</string>
    <string name="mjpeg_method_conditions">آڈیو نہیں · قابلِ رسائی، قابل اعتماد نیٹ ورک · غیر خفیہ کردہ HTTP</string>
    <string name="mjpeg_method_intro">MJPEG آپ کی اسکرین کو تیزی سے بدلتی تصاویر کی صورت میں دکھاتا ہے۔ ناظرین براؤزر میں لنک کھولتے ہیں اور براہ راست اس آلے سے منسلک ہوتے ہیں۔</string>
    <string-array name="mjpeg_method_benefits">
        <item>ناظرین بس لنک کھولتے ہیں۔ کسی ایپ یا اکاؤنٹ کی ضرورت نہیں۔</item>
        <item>جب ناظرین اس آلے تک پہنچ سکیں تو انٹرنیٹ کے بغیر کام کرتا ہے۔</item>
        <item>تصویر کو کراپ کریں، اس کا سائز بدلیں، گھمائیں یا پلٹیں۔</item>
        <item>اختیاری PIN سے دیکھنے کو محفوظ کریں۔ رسائی کے لنکس مدعو ناظرین کو PIN ٹائپ کیے بغیر داخل ہونے دیتے ہیں۔</item>
        <item>MJPEG یا JPEG لنکس قبول کرنے والی دوسری ایپس بھی اسٹریم دکھا سکتی ہیں۔</item>
    </string-array>
    <string-array name="mjpeg_method_things_to_know">
        <item>صرف تصاویر۔ آڈیو نہیں۔</item>
        <item>ناظرین کا اس آلے سے براہ راست منسلک ہونا ضروری ہے، مثلاً ایک ہی Wi-Fi پر یا VPN کے ذریعے۔ مہمان اور عوامی نیٹ ورک اکثر اسے بلاک کرتے ہیں۔</item>
        <item>کنکشن خفیہ کردہ نہیں ہے۔ قابل اعتماد نیٹ ورک استعمال کریں۔</item>
        <item>ہر ناظر کو الگ تصاویر ملتی ہیں، اس لیے زیادہ ناظرین زیادہ ڈیٹا استعمال کرتے ہیں۔</item>
    </string-array>

