    <string name="app_permission_notifications_title">Autoriser les notifications</string>
    <string name="app_permission_notifications_message">Les notifications affichent l\'état de la diffusion et les alertes d\'erreur. Utilisez-les pour arrêter la diffusion ou rouvrir ScreenStream.</string>

    <string name="app_permission_local_network_title">Accès au réseau local</string>
    <string name="app_permission_local_network_message">Autorisez ScreenStream à utiliser votre réseau local pour diffuser vers d’autres appareils du même réseau.\n\nAndroid décrit cette autorisation comme un accès aux Appareils à proximité et peut mentionner la détermination de leur position relative.</string>
    <string name="app_permission_local_network_off_title">Accès au réseau local désactivé</string>
    <string name="app_permission_local_network_settings_message">Dans les paramètres de l’application, ouvrez Autorisations et accordez l’autorisation Appareils à proximité pour diffuser vers des appareils du même réseau local.</string>

    <string name="app_permission_microphone_title">Accès au microphone</string>
    <string name="app_permission_microphone_message">Autorisez l’accès au microphone pour inclure le son du microphone dans le flux.\n\nSans cette autorisation, le son du microphone ne peut pas être diffusé.</string>
    <string name="app_permission_device_audio_title">Accès au son de l’appareil</string>
    <string name="app_permission_device_audio_message">Android exige l’autorisation du microphone pour diffuser le son de l’appareil. Cela n’active pas votre microphone.\n\nSeul le son dont Android et l’application qui le lit autorisent le partage peut être diffusé.</string>

    <string name="app_permission_audio_title">Son du microphone et de l’appareil</string>
    <string name="app_permission_audio_message">Autorisez l’accès au microphone pour diffuser le son du microphone et de l’appareil.\n\nLe son de l’appareil ne peut être diffusé que si Android et l’application qui le lit autorisent son partage.</string>
    <string name="app_permission_audio_settings_message">Activez l\'autorisation du microphone dans les paramètres de l\'application pour diffuser le son du micro ou l\'audio interne.\n\nSans elle, la diffusion sera sans son.</string>

