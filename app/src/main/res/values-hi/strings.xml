    <string name="app_permission_notifications_title">सूचनाओं की अनुमति दें</string>
    <string name="app_permission_notifications_message">सूचनाओं में स्ट्रीम की स्थिति और त्रुटियों की चेतावनियाँ दिखती हैं। इनसे स्ट्रीमिंग रोकें या ScreenStream दोबारा खोलें।</string>

    <string name="app_permission_local_network_title">स्थानीय नेटवर्क एक्सेस</string>
    <string name="app_permission_local_network_message">उसी नेटवर्क के अन्य डिवाइसों पर स्ट्रीम करने के लिए ScreenStream को अपना स्थानीय नेटवर्क इस्तेमाल करने दें।\n\nAndroid इस अनुमति को आस-पास के डिवाइसों के एक्सेस के रूप में बताता है और उनकी सापेक्ष स्थिति का पता लगाने का उल्लेख कर सकता है।</string>
    <string name="app_permission_local_network_off_title">स्थानीय नेटवर्क एक्सेस बंद है</string>
    <string name="app_permission_local_network_settings_message">उसी स्थानीय नेटवर्क के डिवाइसों पर स्ट्रीम करने के लिए ऐप सेटिंग में अनुमतियाँ खोलें और आस-पास मौजूद डिवाइस की अनुमति दें।</string>

    <string name="app_permission_microphone_title">माइक्रोफ़ोन एक्सेस</string>
    <string name="app_permission_microphone_message">स्ट्रीम में अपने माइक्रोफ़ोन की आवाज़ शामिल करने के लिए माइक्रोफ़ोन एक्सेस की अनुमति दें।\n\nइसके बिना, माइक्रोफ़ोन का ऑडियो स्ट्रीम नहीं किया जा सकता।</string>
    <string name="app_permission_device_audio_title">डिवाइस ऑडियो एक्सेस</string>
    <string name="app_permission_device_audio_message">डिवाइस का ऑडियो स्ट्रीम करने के लिए Android को माइक्रोफ़ोन की अनुमति चाहिए। इससे आपका माइक्रोफ़ोन चालू नहीं होता।\n\nकेवल वही ऑडियो स्ट्रीम किया जा सकता है जिसे शेयर करने की अनुमति Android और ऑडियो चलाने वाला ऐप देते हैं।</string>

    <string name="app_permission_audio_title">माइक्रोफ़ोन और डिवाइस का ऑडियो</string>
    <string name="app_permission_audio_message">माइक्रोफ़ोन और डिवाइस का ऑडियो स्ट्रीम करने के लिए माइक्रोफ़ोन एक्सेस की अनुमति दें।\n\nडिवाइस का ऑडियो तभी स्ट्रीम किया जा सकता है जब Android और ऑडियो चलाने वाला ऐप इसे शेयर करने की अनुमति दें।</string>
    <string name="app_permission_audio_settings_message">माइक्रोफ़ोन या आंतरिक ऑडियो स्ट्रीम करने के लिए ऐप सेटिंग में माइक्रोफ़ोन अनुमति चालू करें।\n\nइसके बिना स्ट्रीम में ध्वनि नहीं होगी।</string>

