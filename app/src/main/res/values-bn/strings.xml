    <string name="app_permission_notifications_title">বিজ্ঞপ্তির অনুমতি দিন</string>
    <string name="app_permission_notifications_message">বিজ্ঞপ্তিতে স্ট্রিমের অবস্থা ও ত্রুটির সতর্কতা দেখা যায়। সেগুলো ব্যবহার করে স্ট্রিমিং বন্ধ করুন বা ScreenStream আবার খুলুন।</string>

    <string name="app_permission_local_network_title">স্থানীয় নেটওয়ার্ক অ্যাক্সেস</string>
    <string name="app_permission_local_network_message">একই নেটওয়ার্কের অন্য ডিভাইসে স্ট্রিম করতে ScreenStream-কে আপনার স্থানীয় নেটওয়ার্ক ব্যবহার করার অনুমতি দিন।\n\nAndroid এই অনুমতিকে কাছাকাছি থাকা ডিভাইসে অ্যাক্সেস হিসেবে বর্ণনা করে এবং সেগুলোর আপেক্ষিক অবস্থান নির্ধারণের কথা উল্লেখ করতে পারে।</string>
    <string name="app_permission_local_network_off_title">স্থানীয় নেটওয়ার্ক অ্যাক্সেস বন্ধ আছে</string>
    <string name="app_permission_local_network_settings_message">একই স্থানীয় নেটওয়ার্কের ডিভাইসে স্ট্রিম করতে অ্যাপ সেটিংসে অনুমতি খুলে আশেপাশের ডিভাইসের অনুমতি দিন।</string>

    <string name="app_permission_microphone_title">মাইক্রোফোন অ্যাক্সেস</string>
    <string name="app_permission_microphone_message">স্ট্রিমে আপনার মাইক্রোফোনের শব্দ অন্তর্ভুক্ত করতে মাইক্রোফোন অ্যাক্সেসের অনুমতি দিন।\n\nএটি ছাড়া মাইক্রোফোনের অডিও স্ট্রিম করা যাবে না।</string>
    <string name="app_permission_device_audio_title">ডিভাইসের অডিও অ্যাক্সেস</string>
    <string name="app_permission_device_audio_message">ডিভাইসের অডিও স্ট্রিম করতে Android-এর মাইক্রোফোনের অনুমতি প্রয়োজন। এটি আপনার মাইক্রোফোন চালু করে না।\n\nশুধু Android এবং অডিও চালানো অ্যাপ যে অডিও শেয়ার করার অনুমতি দেয়, তা স্ট্রিম করা যাবে।</string>

    <string name="app_permission_audio_title">মাইক্রোফোন ও ডিভাইসের অডিও</string>
    <string name="app_permission_audio_message">মাইক্রোফোন ও ডিভাইসের অডিও স্ট্রিম করতে মাইক্রোফোন অ্যাক্সেসের অনুমতি দিন।\n\nAndroid এবং অডিও চালানো অ্যাপ শেয়ার করার অনুমতি দিলেই ডিভাইসের অডিও স্ট্রিম করা যাবে।</string>
    <string name="app_permission_audio_settings_message">মাইক্রোফোনের অডিও বা ইন্টারনাল অডিও স্ট্রিম করতে অ্যাপ সেটিংসে মাইক্রোফোনের অনুমতি চালু করুন।\n\nএই অনুমতি না থাকলে স্ট্রিমে শব্দ থাকবে না।</string>

