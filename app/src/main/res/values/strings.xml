    <string name="app_permission_notifications_title">Allow notifications</string>
    <string name="app_permission_notifications_message">Notifications show stream status and error alerts. Use them to stop streaming or reopen ScreenStream.</string>

    <string name="app_permission_local_network_title">Local network access</string>
    <string name="app_permission_local_network_message">Allow ScreenStream to use your local network for streaming to other devices on the same network.\n\nAndroid describes this permission as access to Nearby devices and may mention determining their relative position.</string>
    <string name="app_permission_local_network_off_title">Local network access is off</string>
    <string name="app_permission_local_network_settings_message">In app settings, open Permissions and allow Nearby devices to stream to devices on the same local network.</string>

    <string name="app_permission_microphone_title">Microphone access</string>
    <string name="app_permission_microphone_message">Allow microphone access to include sound from your microphone in the stream.\n\nWithout it, microphone audio cannot be streamed.</string>
    <string name="app_permission_device_audio_title">Device audio access</string>
    <string name="app_permission_device_audio_message">Android requires microphone permission to stream device audio. This does not turn on your microphone.\n\nOnly audio that Android and the playing app allow to be shared can be streamed.</string>

    <string name="app_permission_audio_title">Microphone and device audio</string>
    <string name="app_permission_audio_message">Allow microphone access to stream microphone and device audio.\n\nDevice audio can be streamed only when Android and the playing app allow sharing it.</string>
    <string name="app_permission_audio_settings_message">Enable microphone permission in app settings to stream microphone or internal audio.\n\nWithout it, the stream has no sound.</string>

