    <string name="app_permission_notifications_title">Meldingen toestaan</string>
    <string name="app_permission_notifications_message">Meldingen tonen de streamstatus en foutmeldingen. Gebruik ze om de stream te stoppen of ScreenStream opnieuw te openen.</string>

    <string name="app_permission_local_network_title">Toegang tot lokaal netwerk</string>
    <string name="app_permission_local_network_message">Sta ScreenStream toe uw lokale netwerk te gebruiken om naar andere apparaten op hetzelfde netwerk te streamen.\n\nAndroid beschrijft deze toestemming als toegang tot Apparaten in de buurt en vermeldt mogelijk het bepalen van hun relatieve positie.</string>
    <string name="app_permission_local_network_off_title">Toegang tot lokaal netwerk is uitgeschakeld</string>
    <string name="app_permission_local_network_settings_message">Open Rechten in de appinstellingen en sta Apparaten in de buurt toe om naar apparaten op hetzelfde lokale netwerk te streamen.</string>

    <string name="app_permission_microphone_title">Microfoontoegang</string>
    <string name="app_permission_microphone_message">Sta microfoontoegang toe om geluid van uw microfoon in de stream op te nemen.\n\nZonder deze toestemming kan microfoonaudio niet worden gestreamd.</string>
    <string name="app_permission_device_audio_title">Toegang tot apparaataudio</string>
    <string name="app_permission_device_audio_message">Android vereist microfoontoestemming om apparaataudio te streamen. Dit schakelt uw microfoon niet in.\n\nAlleen audio die Android en de afspelende app toestaan te delen, kan worden gestreamd.</string>

    <string name="app_permission_audio_title">Microfoon- en apparaataudio</string>
    <string name="app_permission_audio_message">Sta microfoontoegang toe om microfoon- en apparaataudio te streamen.\n\nApparaataudio kan alleen worden gestreamd als Android en de afspelende app het delen toestaan.</string>
    <string name="app_permission_audio_settings_message">Schakel microfoonmachtiging in de app-instellingen in om microfoonaudio of interne audio te streamen.\n\nZonder deze machtiging heeft de stream geen geluid.</string>

